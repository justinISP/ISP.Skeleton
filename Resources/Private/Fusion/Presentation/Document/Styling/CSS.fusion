prototype(ISP.Skeleton:Presentation.CSS) < prototype(Neos.Neos:ContentComponent) {

    styles = '
    
        /*---------------------------------------
        CUSTOM PROPERTIES ( VARIABLES )
        -----------------------------------------*/
        :root {
            --white-color:                  #ffffff;
            --primary-color:                #00A3DB;
            --secondary-color:              #5a6f80;
            --section-bg-color:             #f0f8ff;
            --site-footer-bg-color:         #44525d;
            --custom-btn-bg-color:          #597081;
            --custom-btn-bg-hover-color:    #00A3DB;
            --dark-color:                   #000000;
            --p-color:                      #717275;
            --border-color:                 #e9eaeb;

            --body-font-family:             "Metropolis", sans-serif;

            --h1-font-size:                 52px;
            --h2-font-size:                 46px;
            --h3-font-size:                 32px;
            --h4-font-size:                 28px;
            --h5-font-size:                 24px;
            --h6-font-size:                 22px;
            --p-font-size:                  16px;
            --btn-font-size:                18px;
            --copyright-font-size:          14px;

            --border-radius-large:          100px;
            --border-radius-medium:         20px;
            --border-radius-small:          10px;

            --font-weight-light:            300;
            --font-weight-normal:           400;
            --font-weight-semibold:         600;
            --font-weight-bold:             700;
        }

        body {
            background-color: var(--white-color);
            font-family: var(--body-font-family);
        }


        /*---------------------------------------
        TYPOGRAPHY
        -----------------------------------------*/

        h2,
        h3,
        h4,
        h5,
        h6 {
            color: var(--dark-color);
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-weight: var(--font-weight-semibold);
            letter-spacing: -1px;
        }

        h1 {
            font-size: var(--h1-font-size);
            font-weight: var(--font-weight-bold);
            letter-spacing: -2px;
        }

        h2 {
            color: var(--secondary-color);
            font-size: var(--h2-font-size);
            letter-spacing: -2px;
        }

        h3 {
            font-size: var(--h3-font-size);
        }

        h4 {
            font-size: var(--h4-font-size);
        }

        h5 {
            color: var(--primary-color);
            font-size: var(--h5-font-size);
        }

        h6 {
            font-size: var(--h6-font-size);
        }

        p {
            color: var(--p-color);
            font-size: var(--p-font-size);
            font-weight: var(--font-weight-light);
        }

        ul li {
            color: var(--p-color);
            font-size: var(--p-font-size);
            font-weight: var(--font-weight-normal);
        }

        a,
        button {
            touch-action: manipulation;
            transition: all 0.3s;
        }

        a {
            color: var(--p-color);
            text-decoration: none;
        }

        a:hover {
            color: var(--primary-color);
        }

        b,
        strong {
            font-weight: var(--font-weight-bold);
        }


        /*---------------------------------------
        SECTIONS (general)
        -----------------------------------------*/

        .section-padding {
            padding-top: 100px;
            padding-bottom: 100px;
        }

        .section-bg {
            background-color: var(--section-bg-color);
        }

        .section-overlay {
            background: rgba(0, 0, 0, 0.35);
            position: absolute;
            top: 0;
            left: 0;
            pointer-events: none;
            width: 100%;
            height: 100%;
        }

        .section-overlay + .container {
            position: relative;
        }



        /*---------------------------------------
        CUSTOM BUTTON
        -----------------------------------------*/
        .custom-btn {
            background: var(--secondary-color);
            border: 2px solid transparent;
            border-radius: var(--border-radius-large);
            color: var(--white-color);
            font-size: var(--btn-font-size);
            font-weight: var(--font-weight-normal);
            line-height: normal;
            padding: 15px 25px;
        }

        .navbar-expand-lg .navbar-nav .nav-link.custom-btn {
            color: var(--custom-btn-bg-color);
            margin-top: 8px;
            padding: 12px 25px;
        }

        .custom-btn:hover {
            background: var(--primary-color);
            color: var(--white-color);
        }

        .navbar-expand-lg .navbar-nav .nav-link.custom-btn:hover,
        .custom-border-btn:hover {
            background: var(--custom-btn-bg-hover-color);
            border-color: transparent;
            color: var(--white-color);
        }

        /*---------------------------------------
        ABOUT
        -----------------------------------------*/

        .about-image {
            border-radius: var(--border-radius-medium);
            display: block;
            width: 350px;
            height: 400px;
            object-fit: cover;
        }

        /*******************************************
        Breadcrump
        ********************************************/


        breadcrumb {
            text-align: left;
            padding: 5px 15px;
            width: 100%;
            margin-bottom: 50px;
            font-size: 0.9em;
            list-style-type: none;
            background-color: #ffffff;
        }
        .breadcrumb li:before
        {
            content: "\BB" " ";
            float:left;
            color: var(--primary-color);
            padding: 0 7px 0 0;
        }
        ul.breadcrumbs {
            list-style-type: none;
        }
        .breadcrumb li {
            float:left;
            margin-right: 7px;
        }

        /*===============================
        Columns
        =================================*/

        .neos-nodetypes-headline,
        .neos-nodetypes-text,
        .neos-nodetypes-textwithimage,
        .neos-nodetypes-image,
        .neos-nodetypes-html-html {
            padding-left: 15px;
            padding-right: 15px;
            clear:both;
        }
        .column .neos-nodetypes-headline,
        .column .neos-nodetypes-text,
        .column .neos-nodetypes-textwithimage,
        .column .neos-nodetypes-image,
        .column .neos-nodetypes-html-html,
        .container-fluid-kamn .neos-nodetypes-image,
        .container-fluid-kamn .neos-nodetypes-textwithimage {
            padding-left: 0;
            padding-right: 0;
        }
        .column img {width:100%;height:auto;}
        /* Gemeinsame Grundstruktur */
        [class*="columns-"] {
            display: flex;
            flex-wrap: wrap;
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
        }

        /* Standard für Spalten */
        [class*="columns-"] .column {
            box-sizing: border-box;
            padding: 10px;
            min-height: 1px;
        }

        /* Varianten */

        /* 50/50 */
        .columns-50-50 .column {
            flex: 0 0 50%;
            max-width: 50%;
        }

        /* 33/33/33 */
        .columns-33-33-33 .column {
            flex: 0 0 33.3333%;
            max-width: 33.3333%;
        }

        /* 66/33 */
        .columns-66-33 .column:first-of-type {
            flex: 0 0 66.6666%;
            max-width: 66.6666%;
            padding-right: 15px;
        }
        .columns-66-33 .column:last-of-type {
            flex: 0 0 33.3333%;
            max-width: 33.3333%;
            padding-left: 15px;
        }

        /* 33/66 */
        .columns-33-66 .column:first-of-type {
            flex: 0 0 33.3333%;
            max-width: 33.3333%;
            padding-right: 15px;
        }
        .columns-33-66 .column:last-of-type {
            flex: 0 0 66.6666%;
            max-width: 66.6666%;
            padding-left: 15px;
        }

        /* 25/25/25/25 */
        .columns-25-25-25-25 .column {
            flex: 0 0 25%;
            max-width: 25%;
            padding: 10px;
        }

        /* 25/50/25 */
        .columns-25-50-25 .column:first-of-type,
        .columns-25-50-25 .column:last-of-type {
            flex: 0 0 25%;
            max-width: 25%;
        }
        .columns-25-50-25 .column:nth-of-type(2) {
            flex: 0 0 50%;
            max-width: 50%;
        }

        /* 75 / 25 */
        .columns-75-25 .column:first-of-type {
            flex: 0 0 75%;
            max-width: 75%;
            padding-right: 15px;
        }
        .columns-75-25 .column:last-of-type {
            flex: 0 0 25%;
            max-width: 25%;
            padding-left: 15px;
        }

        /* 25 / 75 */
        .columns-25-75 .column:first-of-type {
            flex: 0 0 25%;
            max-width: 25%;
            padding-right: 15px;
        }
        .columns-25-75 .column:last-of-type {
            flex: 0 0 75%;
            max-width: 75%;
            padding-left: 15px;
        }

        /* 50 / 25 / 25 */
        .columns-50-25-25 .column:first-of-type {
            flex: 0 0 50%;
            max-width: 50%;
        }
        .columns-50-25-25 .column:nth-of-type(2),
        .columns-50-25-25 .column:last-of-type {
            flex: 0 0 25%;
            max-width: 25%;
        }

        /* 25 / 25 / 50 */
        .columns-25-25-50 .column:first-of-type,
        .columns-25-25-50 .column:nth-of-type(2) {
            flex: 0 0 25%;
            max-width: 25%;
        }
        .columns-25-25-50 .column:last-of-type {
            flex: 0 0 50%;
            max-width: 50%;
        }
        
        /* Responsive Anpassungen */
        @media all and (max-width:640px) {
            [class*="columns-"] .column {
                flex: 0 0 100% !important;
                max-width: 100% !important;
                padding: 10px !important;
            }
        }

        @media all and (max-width:480px) {
            [class*="columns-"] .column {
                flex: 0 0 100% !important;
                max-width: 100% !important;
                padding: 10px 0 !important;
            }
        }

        /*---------------------------------------
        RESPONSIVE STYLES
        -----------------------------------------*/
        @media screen and (min-width: 1600px) {

        }

        @media screen and (max-width: 1170px) {
            .hero-section .carousel-image {
                height: 100%;
                object-fit: cover;
            }
        }

        @media screen and (max-width: 991px) {
            h1 {
                font-size: 42px;
            }

            h2 {
                font-size: 36px;
            }

            h3 {
                font-size: 32px;
            }

            h4 {
                font-size: 28px;
            }

            h5 {
                font-size: 20px;
            }

            h6 {
                font-size: 18px;
            }

            .section-padding {
                padding-top: 50px;
                padding-bottom: 50px;
            }
            .navbar {
                padding-top: 6px;
                padding-bottom: 6px;
            }
            .navbar-expand-lg .navbar-nav {
                padding-bottom: 30px;
            }
            .navbar-expand-lg .navbar-nav .nav-link {
                padding: 8px 20px;
            }
            .dropdown:hover .dropdown-menu {
                display: block;
                position: relative;
                margin-top: 5px;
                margin-bottom: 20px;
                left: 20px;
            }
            .hero-section-full-height {
                height: inherit;
            }
            .carousel:hover .carousel-control-next-icon,
            .carousel:hover .carousel-control-prev-icon {
                opacity: 1;
            }
            .hero-section .carousel-item {
                height: inherit;
            }
            .carousel-control-prev {
                left: 12px;
            }
            .carousel-control-next {
                right: 12px;
            }
            .carousel-control-next-icon,
            .carousel-control-prev-icon {
                opacity: 1;
                width: 60px;
                height: 60px;
            }
            blockquote {
                padding: 70px 30px 30px 30px;
            }
            .about-image {
                width: inherit;
                height: 450px;
            }
            .custom-text-block {
                padding: 20px 0 0 0;
            }
            .site-footer {
                padding-top: 50px;
            }
            .copyright-text-wrap {
                justify-content: center;
            }
            .site-footer-bottom {
                text-align: center;
                margin-top: 50px;
            }
            .site-footer-bottom .footer-menu {
                margin-top: 10px;
                margin-bottom: 10px;
            }
        }

        @media screen and (max-width: 580px) {
            .hero-section-full-height,
            .hero-section .carousel-item,
            .carousel-image {
                min-height: 520px;
            }
            .hero-section .carousel-caption {
                clip-path: polygon(100% 100%, 100% 100px, 0 100%);
                padding-right: 50px;
                min-width: inherit;
                min-height: inherit;
            }
        }

        @media screen and (max-width: 480px) {
            h1 {
                font-size: 40px;
            }
            h2 {
                font-size: 28px;
            }
            h3 {
                font-size: 26px;
            }
            h4 {
                font-size: 22px;
            }
            h5 {
                font-size: 20px;
            }
            .hero-section .carousel-caption {
                min-width: inherit;
                padding-bottom: 30px;
            }
            .social-share .tags-block {
                margin-bottom: 10px;
            }
        }    
    
    '

}    
