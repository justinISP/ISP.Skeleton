// TODO Neos.Neos-20251005080230 Line 19: You may need to rewrite "VARIABLE.identifier" to "VARIABLE.aggregateId". We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
##
# "Carousel" element
#
prototype(ISP.Skeleton:Carousel) < prototype(Neos.Neos:ContentComponent) {

    identifier = ${'id-' + node.aggregateId}

    carouselItems = Neos.Neos:ContentCollection {
        nodePath = 'carouselitems'
        attributes {
            class = 'tn-slider'
            dir = 'ltr'
        }    
    }

    renderer = afx`
        <div>
            <div class="caruslider" id={props.identifier}>
                {props.carouselItems}
            </div>
        </div>
    `
}
